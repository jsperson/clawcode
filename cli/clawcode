#!/usr/bin/env bash
# ClawCode CLI — launches Claude Code with ClawCode context
set -euo pipefail

CLAWCODE_DIR="$HOME/clawcode"
CLAUDE="$HOME/.npm-global/bin/claude"
VAULT="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/scott"
VENV_PYTHON="$CLAWCODE_DIR/.venv/bin/python"
CONTEXT_CACHE="$CLAWCODE_DIR/data/context.cache"

# Ensure project dir exists
if [ ! -d "$CLAWCODE_DIR" ]; then
    echo "Error: $CLAWCODE_DIR does not exist" >&2
    exit 1
fi

# cd so .claude/CLAUDE.md is loaded automatically
cd "$CLAWCODE_DIR"

# ---------------------------------------------------------------------------
# Banner + terminal title (interactive sessions only)
# ---------------------------------------------------------------------------

_set_title() {
    # Set terminal tab title (works in iTerm2, Tabby, most terminals)
    printf '\033]0;ClawCode\007'
}

_read_identity() {
    # Parse Name and Creature from IDENTITY.md
    local id_file="$CLAWCODE_DIR/IDENTITY.md"
    IDENTITY_NAME="ClawCode"
    IDENTITY_CREATURE=""
    if [ -f "$id_file" ]; then
        IDENTITY_NAME=$(grep -m1 '^- Name:' "$id_file" | sed 's/^- Name: *//' || echo "ClawCode")
        IDENTITY_CREATURE=$(grep -m1 '^- Creature:' "$id_file" | sed 's/^- Creature: *//' || true)
    fi
}

_banner() {
    local CYAN='\033[36m'
    local DIM='\033[2m'
    local RESET='\033[0m'
    _set_title
    _read_identity
    printf "${CYAN}"
    cat <<'BANNER'
   _____ _                 _____          _
  / ____| |               / ____|        | |
 | |    | | __ ___      _| |     ___   __| | ___
 | |    | |/ _` \ \ /\ / / |    / _ \ / _` |/ _ \
 | |____| | (_| |\ V  V /| |___| (_) | (_| |  __/
  \_____|_|\__,_| \_/\_/  \_____\___/ \__,_|\___|
BANNER
    if [ -n "$IDENTITY_CREATURE" ]; then
        printf "${DIM}  %s // %s${RESET}\n\n" "$IDENTITY_NAME" "$IDENTITY_CREATURE"
    else
        printf "${DIM}  %s${RESET}\n\n" "$IDENTITY_NAME"
    fi
}

# ---------------------------------------------------------------------------
# Theme swap — use a distinct theme so ClawCode looks different from claude
# ---------------------------------------------------------------------------

CLAUDE_JSON="$HOME/.claude.json"
CLAWCODE_THEME="dark"
_ORIG_THEME=""

_swap_theme() {
    # Save original theme and set ClawCode theme
    if [ -f "$CLAUDE_JSON" ]; then
        _ORIG_THEME=$("$VENV_PYTHON" -c "
import json, sys
try:
    d = json.load(open('$CLAUDE_JSON'))
    print(d.get('theme', ''))
except: pass
" 2>/dev/null || true)
    fi
    "$VENV_PYTHON" -c "
import json
p = '$CLAUDE_JSON'
try:
    d = json.load(open(p))
except: d = {}
d['theme'] = '$CLAWCODE_THEME'
json.dump(d, open(p, 'w'), indent=2)
print()
" 2>/dev/null
}

_restore_theme() {
    # Restore original theme on exit
    if [ -n "$_ORIG_THEME" ] && [ -f "$CLAUDE_JSON" ]; then
        "$VENV_PYTHON" -c "
import json
p = '$CLAUDE_JSON'
try:
    d = json.load(open(p))
except: d = {}
d['theme'] = '$_ORIG_THEME'
json.dump(d, open(p, 'w'), indent=2)
print()
" 2>/dev/null
    fi
}

# Build context args from cache
_context_args() {
    if [ -f "$CONTEXT_CACHE" ] && [ -s "$CONTEXT_CACHE" ]; then
        echo "--append-system-prompt"
        cat "$CONTEXT_CACHE"
    fi
}

if [ $# -eq 0 ]; then
    _banner
    _swap_theme
    trap '_restore_theme' EXIT
    # Interactive session (no exec — need to restore theme on exit)
    CONTEXT=$(cat "$CONTEXT_CACHE" 2>/dev/null || true)
    if [ -n "$CONTEXT" ]; then
        "$CLAUDE" --dangerously-skip-permissions --add-dir "$VAULT" --append-system-prompt "$CONTEXT"
    else
        "$CLAUDE" --dangerously-skip-permissions --add-dir "$VAULT"
    fi

elif [ "$1" = "doctor" ]; then
    # Health check
    exec "$VENV_PYTHON" "$CLAWCODE_DIR/scripts/doctor.py"

elif [ "$1" = "skill" ]; then
    shift
    if [ $# -eq 0 ]; then
        echo "Usage: clawcode skill <list|install|search>" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  list                  Show installed skills and status" >&2
        echo "  install <name>        Install a skill from ClewHub" >&2
        echo "  search <query>        Search ClewHub for skills" >&2
        exit 1
    fi

    subcmd="$1"
    shift

    case "$subcmd" in
        list)
            echo "ClawCode Skills"
            echo "==============="
            echo ""
            "$VENV_PYTHON" -c "
import sys
sys.path.insert(0, '$CLAWCODE_DIR')
from skills.loader import load_skills, check_eligible, _get_skill_metadata

skills = load_skills('$CLAWCODE_DIR/skills')
if not skills:
    print('  No skills installed.')
    sys.exit(0)

for s in skills:
    eligible = check_eligible(s)
    ns = _get_skill_metadata(s.metadata)
    source = 'clawdbot' if s.metadata.get('clawdbot') else 'clawcode'
    status = 'ready' if eligible else 'unavailable'
    emoji = ns.get('emoji', '')
    desc = s.description.split(chr(10))[0][:60] if s.description else '(no description)'
    print(f'  {emoji + \" \" if emoji else \"\"}{s.name:20s}  [{status:12s}]  ({source})  {desc}')
"
            ;;
        install)
            if [ $# -eq 0 ]; then
                echo "Usage: clawcode skill install <name>" >&2
                exit 1
            fi
            if command -v clawdhub >/dev/null 2>&1; then
                exec clawdhub install --workdir "$CLAWCODE_DIR" "$@"
            else
                echo "Error: clawdhub CLI not found" >&2
                echo "Install it with: pip install clawdhub" >&2
                exit 1
            fi
            ;;
        search)
            if [ $# -eq 0 ]; then
                echo "Usage: clawcode skill search <query>" >&2
                exit 1
            fi
            if command -v clawdhub >/dev/null 2>&1; then
                exec clawdhub search "$@"
            else
                echo "Error: clawdhub CLI not found" >&2
                echo "Install it with: pip install clawdhub" >&2
                exit 1
            fi
            ;;
        *)
            echo "Unknown skill command: $subcmd" >&2
            echo "Usage: clawcode skill <list|install|search>" >&2
            exit 1
            ;;
    esac

elif [ "$1" = "schedule" ]; then
    shift
    if [ $# -eq 0 ]; then
        echo "Usage: clawcode schedule <sync|list|logs>" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  sync          Sync schedules.yaml to launchd agents" >&2
        echo "  list          Show current schedules and status" >&2
        echo "  logs <name>   Tail the log for a schedule" >&2
        exit 1
    fi

    subcmd="$1"
    shift

    case "$subcmd" in
        sync)
            exec "$VENV_PYTHON" "$CLAWCODE_DIR/scripts/schedule-sync.py"
            ;;
        list)
            # Quick list via launchctl + schedules.yaml
            echo "ClawCode Schedules"
            echo "=================="
            echo ""

            # Show YAML-defined schedules
            if [ -f "$CLAWCODE_DIR/config/schedules.yaml" ]; then
                "$VENV_PYTHON" -c "
import yaml, json, subprocess
from pathlib import Path

project = Path('$CLAWCODE_DIR')

with open(project / 'config' / 'schedules.yaml') as f:
    schedules = yaml.safe_load(f).get('schedules', {})

# Load state
state_path = project / 'data' / 'state.json'
try:
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
except:
    state = {}
last_runs = state.get('last_run', {})

# Check launchd
result = subprocess.run(['launchctl', 'list'], capture_output=True, text=True)
loaded = set()
for line in result.stdout.splitlines():
    parts = line.split('\t')
    if len(parts) >= 3 and parts[2].startswith('com.clawcode.schedule.'):
        loaded.add(parts[2].replace('com.clawcode.schedule.', ''))

for name, sched in schedules.items():
    enabled = sched.get('enabled', True)
    cron = sched.get('cron', '?')
    is_loaded = name in loaded

    if enabled and is_loaded:
        status = 'active'
    elif enabled:
        status = 'enabled (not loaded)'
    else:
        status = 'disabled'

    last = last_runs.get(name, 'never')
    print(f'  {name:20s}  [{status:20s}]  cron: {cron:15s}  last: {last}')
"
            else
                echo "  No schedules.yaml found"
            fi
            ;;
        logs)
            if [ $# -eq 0 ]; then
                echo "Usage: clawcode schedule logs <name>" >&2
                echo "" >&2
                echo "Available logs:" >&2
                ls "$CLAWCODE_DIR/data/logs/schedule-"*.log 2>/dev/null | while read f; do
                    basename "$f" .log | sed 's/^schedule-/  /'
                done
                exit 1
            fi
            logfile="$CLAWCODE_DIR/data/logs/schedule-$1.log"
            if [ -f "$logfile" ]; then
                tail -f "$logfile"
            else
                echo "No log file found: $logfile" >&2
                echo "The schedule may not have run yet." >&2
                exit 1
            fi
            ;;
        *)
            echo "Unknown schedule command: $subcmd" >&2
            echo "Usage: clawcode schedule <sync|list|logs>" >&2
            exit 1
            ;;
    esac

elif [ "$1" = "memory" ]; then
    # memory search|index|stats
    shift
    exec "$VENV_PYTHON" -m bot.memory_search "$@"

elif [ "$1" = "tui" ]; then
    # TUI client — attach to gateway session, run claude interactively
    _banner
    _swap_theme
    trap '_restore_theme' EXIT
    "$VENV_PYTHON" "$CLAWCODE_DIR/cli/tui.py"

elif [ "$1" = "restart" ]; then
    # Graceful restart via launchd — sends SIGTERM, then restarts
    echo "Restarting ClawCode bot..."
    launchctl kickstart -k "gui/$(id -u)/com.clawcode.bot"
    echo "Restart signal sent. Bot should be back within ~10 seconds."

elif [ "$1" = "--continue" ]; then
    # Resume last session
    _banner
    _swap_theme
    trap '_restore_theme' EXIT
    shift
    CONTEXT=$(cat "$CONTEXT_CACHE" 2>/dev/null || true)
    if [ -n "$CONTEXT" ]; then
        "$CLAUDE" --continue --dangerously-skip-permissions --add-dir "$VAULT" --append-system-prompt "$CONTEXT" "$@"
    else
        "$CLAUDE" --continue --dangerously-skip-permissions --add-dir "$VAULT" "$@"
    fi

else
    # One-shot query
    CONTEXT=$(cat "$CONTEXT_CACHE" 2>/dev/null || true)
    if [ -n "$CONTEXT" ]; then
        exec "$CLAUDE" --print --dangerously-skip-permissions --add-dir "$VAULT" --append-system-prompt "$CONTEXT" -p "$*"
    else
        exec "$CLAUDE" --print --dangerously-skip-permissions --add-dir "$VAULT" -p "$*"
    fi
fi
