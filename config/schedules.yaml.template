schedules:
  inbox_check:
    cron: "*/30 * * * *"
    prompt: "/process-inbox"
    enabled: false

  reminder_check:
    cron: "0 * * * *"
    prompt: "Check remindctl for overdue and due-today items. Surface anything that needs attention."
    enabled: false  # subsumed by in-process heartbeat lightweight checks

  # end_of_day: migrated to in-process heartbeat standing orders
  # weekly_review: migrated to in-process heartbeat (Phase 2 self-improvement)

  weekly_trends:
    cron: "0 3 * * 1"
    prompt: >
      Generate the weekly macro trends journal entry for Obsidian.

      Search for current news and signals across these domains:

      1. **Technology/AI** — Models, infrastructure, platforms, developer tools, adoption patterns

      2. **Geopolitics** — Power shifts, trade policy, conflict, alliances, sanctions

      3. **Macro Economics** — Growth indicators, monetary policy, labor markets, inflation

      4. **Financial Stability** — Banking stress signals (CDS spreads, discount window, loan losses), sovereign debt risk (EM spreads, IMF activity, currency stress), trade disputes, systemic risk gauges (credit spreads, repo rates)

      5. **Market Volatility Signals** — VIX/VVIX/skew, dealer gamma positioning, options flow anomalies, liquidity conditions, catalyst calendar (FOMC, CPI, earnings clusters, OpEx), cross-asset warnings (yen carry, DXY spikes, correlation breaks)

      6. **Consumer Credit Health** — Bank of America credit card performance metrics (delinquency rates, charge-off rates, payment rates, credit utilization trends), consumer spending patterns, credit card debt levels, FICO score distribution shifts

      Create a new entry at OBSIDIAN_VAULT/Trends/ using the format from 2026-W04.md. Include signals, thread updates, and questions to track.

      Post a summary to the main session when complete.
    enabled: true

  life_overnight:
    cron: "0 2 * * *"
    prompt: "Run /life:overnight"
    enabled: true

  life_evening:
    cron: "0 21 * * *"
    prompt: "Run /life:evening"
    enabled: true

  daily_digest:
    cron: "0 7 * * *"
    script: "bash ~/clawcode/scripts/daily-digest.sh"
    enabled: true

  daily_backup:
    cron: "0 1 * * *"
    script: "bash ~/clawcode/scripts/backup.sh"
    enabled: true

  # heartbeat: migrated to in-process heartbeat loop in bot/main.py
